# DeepSeek Web Protocol Investigation - Environment Configuration
# Copy this file to .env and fill in your own session credentials
# NEVER commit .env to version control

# Authorization header from browser (Bearer token)
DEEPSEEK_AUTHORIZATION=

# Session ID from browser cookies
DEEPSEEK_SESSION_ID=

# Chat session ID from URL (e.g., /a/chat/s/<chat_session_id>)
DEEPSEEK_CHAT_SESSION_ID=

# Cookie header from browser (full cookie string)
DEEPSEEK_COOKIE=

# x-ds-pow-response value from browser request
DEEPSEEK_POW_RESPONSE=

# x-hif-leim value from browser request
DEEPSEEK_HIF_LEIM=

# User-Agent to mimic browser
DEEPSEEK_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Base URL for DeepSeek API
DEEPSEEK_BASE_URL=https://chat.deepseek.com

# Enable live testing (requires valid credentials)
DEEPSEEK_LIVE_TESTS=0